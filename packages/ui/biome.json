{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "files": {
    "includes": [
      "src/**",
      "!src/charts/maps/data/*/index.ts",
      "!src/icons",
      "!src/utils/class-tokens.generated.ts",
      "src/icons/icon-base.tsx",
      "scripts/**",
      "!scripts/build-theme.mjs",
      "test/*.mjs",
      "tsup.config.ts"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true },
  "overrides": [
    {
      "includes": [
        "src/calendar/month-view/month-view.tsx",
        "src/calendar/week-view/week-view.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": { "useSemanticElements": "off", "useFocusableInteractive": "off" }
        }
      }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
