{
  "name": "@jcsoftdev/ui",
  "version": "0.1.7",
  "description": "Token-driven React component library: React 19, Radix, Tailwind v4.",
  "author": "jcsoftdev",
  "license": "MIT",
  "homepage": "https://ui.jcsoftdev.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcsoftdev/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/jcsoftdev/ui/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "ui",
    "component-library",
    "design-system",
    "design-tokens",
    "radix-ui",
    "tailwindcss",
    "tailwind-v4",
    "charts",
    "data-grid",
    "typescript"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "ui-theme": "./bin/ui-theme.mjs"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.*",
    "!src/**/*.test.*",
    "styles",
    "tokens",
    "bin",
    "scripts/build-theme.mjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./styles/*": "./styles/*",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json",
    "./rich-text": {
      "types": "./dist/rich-text/index.d.ts",
      "source": "./src/rich-text/index.ts",
      "import": "./dist/rich-text/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "source": "./src/*/index.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:styles && tsup && tsc -p tsconfig.build.json",
    "build:styles": "node bin/ui-theme.mjs build tokens/default.json --out styles",
    "lint": "biome check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "test:stories": "vitest run --project stories",
    "check:treeshake": "node test/treeshake.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "esbuild": "^0.28.2",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.5.4",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
