{
  "name": "@jcsoftdev/ui",
  "version": "0.1.0",
  "description": "Token-driven React component library: React 19, Radix, Tailwind v4.",
  "author": "jcsoftdev",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "bin": {
    "ui-theme": "./bin/ui-theme.mjs"
  },
  "files": [
    "dist",
    "src",
    "styles",
    "tokens",
    "bin",
    "scripts/build-theme.mjs"
  ],
  "exports": {
    "./styles/*": "./styles/*",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "source": "./src/*/index.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:styles && tsup && tsc -p tsconfig.build.json",
    "build:styles": "node bin/ui-theme.mjs build tokens/default.json --out styles",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/build-theme.test.mjs",
    "check:treeshake": "node test/treeshake.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.4"
  }
}
