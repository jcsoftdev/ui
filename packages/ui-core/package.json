{
  "name": "@jcsoftdev/ui-core",
  "version": "0.2.0",
  "description": "Framework-agnostic UI behaviour (focus scope, roving focus, popper, dismiss layers, typeahead) and a granular, lazily loaded Liquid Glass engine. Zero dependencies.",
  "author": "jcsoftdev",
  "license": "MIT",
  "homepage": "https://ui.jcsoftdev.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcsoftdev/ui.git",
    "directory": "packages/ui-core"
  },
  "bugs": {
    "url": "https://github.com/jcsoftdev/ui/issues"
  },
  "keywords": [
    "headless",
    "focus-trap",
    "roving-tabindex",
    "popper",
    "dismissable-layer",
    "liquid-glass",
    "vanilla-js",
    "web-components"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./focus": {
      "types": "./dist/focus.d.ts",
      "import": "./dist/focus.js"
    },
    "./roving": {
      "types": "./dist/roving.d.ts",
      "import": "./dist/roving.js"
    },
    "./popper": {
      "types": "./dist/popper.d.ts",
      "import": "./dist/popper.js"
    },
    "./dismiss": {
      "types": "./dist/dismiss.d.ts",
      "import": "./dist/dismiss.js"
    },
    "./typeahead": {
      "types": "./dist/typeahead.d.ts",
      "import": "./dist/typeahead.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "pnpm build && node --test test/ssr.test.mjs && vitest run --project unit",
    "check:treeshake": "node test/treeshake.mjs",
    "check:pack": "node ../../scripts/pack-check.mjs packages/ui-core",
    "test:browser": "vitest run --project browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^20",
    "@vitest/browser-playwright": "4.1.11",
    "esbuild": "^0.28.2",
    "playwright": "1.64.0",
    "typescript": "^5.5.4",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
