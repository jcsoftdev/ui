---
import Landing from "../layouts/Landing.astro";
import Playground from "../components/glass/Playground";
import "../styles/glass-demo.css";
---

<Landing
  title="Liquid Glass playground | @jcsoftdev/ui"
  description="Tune every Liquid Glass option live over a real photo, drag the glass anywhere, then copy the material prop or the CSS variables."
  active="playground"
>
  <section class="landing-section pt-6 pb-12">
    <div class="landing-wrap">
      <div class="mb-4 max-w-3xl">
        <p class="landing-kicker">Interactive playground</p>
        <h1 class="landing-h2 !text-[1.75rem]">Liquid Glass, every knob</h1>
        <p class="landing-lead !mt-2 !text-base">
          Move the sliders, pick a photo, drag the panel anywhere (or focus it and use the arrow
          keys), then copy the <code>material</code> prop or the CSS variables. What each option
          does: <a href="/docs/glass/">glass guide</a>.
        </p>
      </div>
      <Playground client:load />
    </div>
  </section>
</Landing>
