---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="wordmark" aria-label="@jcsoftdev/ui, home">
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="9" fill="var(--accent)"></rect>
    <path
      d="M9 9v8.5a7 7 0 0 0 14 0V9"
      fill="none"
      stroke="var(--on-accent)"
      stroke-width="3.2"
      stroke-linecap="round"
    ></path>
  </svg>
  <span translate="no">
    <b>@jcsoftdev</b>/ui
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  b {
    font-weight: 800;
  }
</style>
